{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phémios",
  "version": "0.2.0",
  "identifier": "fr.craftandcode.phemios",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/prepare-engine.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phḗmios",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 550,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'self'; media-src https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "externalBin": ["binaries/phemios-aede"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
