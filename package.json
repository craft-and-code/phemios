{
  "name": "phemios",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/tauri.mjs",
    "test": "node --test tests/*.test.mjs && vitest run",
    "check:tauri": "node scripts/check-tauri-versions.mjs",
    "check": "bash tools/check.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src scripts tests docs/components vite.config.ts vitest.config.ts vite.analysis.config.ts vite.web.config.ts",
    "build:native": "tauri build --bundles app && node scripts/check-macos-bundle.mjs",
    "docs:ts": "node scripts/typescript-docs.mjs",
    "components:dev": "node scripts/component-explorer.mjs dev",
    "components:build": "node scripts/component-explorer.mjs build",
    "components:check": "tsc --noEmit -p docs/components/tsconfig.json && npm run components:build",
    "engines:check": "node scripts/update-engines.mjs --check",
    "engines:update": "node scripts/update-engines.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node scripts/check-site.mjs dist-site",
    "analysis:build": "vite build --config vite.analysis.config.ts",
    "audit:dependencies": "node scripts/vendor-audit.mjs",
    "check:vendor": "node scripts/vendor-audit.mjs --verify-only",
    "web:dev": "node scripts/web.mjs",
    "web:build": "node scripts/build-web-audio.mjs && tsc --noEmit && vite build --config vite.web.config.ts",
    "web:serve": "node scripts/serve-web.mjs",
    "web:test": "node --test tests/web-audio.wasm-test.mjs",
    "web:build:demo": "node scripts/build-web-demo.mjs"
  },
  "dependencies": {
    "@milkdown/kit": "7.22.2",
    "@tauri-apps/api": "2.12.1",
    "d3-geo": "3.1.1",
    "lucide-solid": "1.61.0",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.4",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "storybook": "10.6.3",
    "storybook-solidjs-vite": "10.7.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3"
  }
}
