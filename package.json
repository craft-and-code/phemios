{
  "name": "phemios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs && vitest run",
    "check:tauri": "node scripts/check-tauri-versions.mjs",
    "check": "bash tools/check.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src scripts tests vite.config.ts vitest.config.ts",
    "build:native": "tauri build --bundles app"
  },
  "dependencies": {
    "solid-js": "1.9.17",
    "@tauri-apps/api": "2.12.1"
  },
  "devDependencies": {
    "vite": "8.3.3",
    "vite-plugin-solid": "2.11.14",
    "typescript": "7.0.2",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "prettier": "3.9.9",
    "oxlint": "1.87.0",
    "vitest": "5.0.3"
  }
}
